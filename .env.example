# AeroSentinel Environment Variables
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# ============================================================
# System
# ============================================================

# Log level for the AeroSentinel system: DEBUG, INFO, WARNING, ERROR, CRITICAL
AEROSENTINEL_LOG_LEVEL=INFO

# Log directory (absolute path)
AEROSENTINEL_LOG_DIR=/home/pi/AeroSentinal_VK_2027/data/logs

# Data directory root
AEROSENTINEL_DATA_DIR=/home/pi/AeroSentinal_VK_2027/data

# Config directory
AEROSENTINEL_CONFIG_DIR=/home/pi/AeroSentinal_VK_2027/config

# Models directory
AEROSENTINEL_MODELS_DIR=/home/pi/AeroSentinal_VK_2027/models

# ============================================================
# Pi Camera 3 (Module A)
# ============================================================

# Resolution: WIDTHxHEIGHT
CAMERA_RESOLUTION=1920x1080

# Capture frame rate (FPS)
CAMERA_FPS=30

# AI input frame rate (sub-sampled from capture FPS)
CAMERA_AI_FPS=10

# Camera rotation in degrees (0, 90, 180, 270)
CAMERA_ROTATION=0

# Auto focus: 0=disabled (fixed), 1=enabled
CAMERA_AUTOFOCUS=0

# Fixed focus distance in metres (used when autofocus is disabled)
CAMERA_FOCUS_DISTANCE=3.0

# ============================================================
# Intel RealSense D435i (Module A)
# ============================================================

# Depth stream resolution: WIDTHxHEIGHT
REALSENSE_DEPTH_RESOLUTION=640x480

# Depth stream FPS
REALSENSE_DEPTH_FPS=15

# RGB stream resolution: WIDTHxHEIGHT
REALSENSE_RGB_RESOLUTION=848x480

# RGB stream FPS
REALSENSE_RGB_FPS=15

# IMU stream sample rate (Hz)
REALSENSE_IMU_RATE=200

# Obstacle safety threshold (metres): alert if obstacle closer than this
REALSENSE_OBSTACLE_THRESHOLD=1.0

# ============================================================
# AI Inference / Survivor Detection (Module B)
# ============================================================

# Path to ONNX model file (absolute path recommended)
AI_MODEL_PATH=/home/pi/AeroSentinal_VK_2027/models/yolov8n.onnx

# Model input size (WIDTHxHEIGHT)
AI_INPUT_SIZE=320x320

# Detection confidence threshold (0.0 to 1.0)
AI_CONFIDENCE_THRESHOLD=0.50

# NMS IoU threshold (0.0 to 1.0)
AI_NMS_THRESHOLD=0.45

# ONNX Runtime intra-op threads (leave 1 core free for other modules)
AI_INTRA_OP_THREADS=2

# ============================================================
# MAVLink / Flight Controller (Module I)
# ============================================================

# Connection type: serial or udp
MAVLINK_CONNECTION_TYPE=serial

# Serial port for UART connection
MAVLINK_SERIAL_PORT=/dev/ttyAMA0

# Serial baud rate
MAVLINK_BAUD_RATE=921600

# UDP host and port (used when MAVLINK_CONNECTION_TYPE=udp)
MAVLINK_UDP_HOST=127.0.0.1
MAVLINK_UDP_PORT=14550

# Reconnect interval in seconds
MAVLINK_RECONNECT_INTERVAL=5

# ============================================================
# Dashboard / Ground Control (Module J)
# ============================================================

# Dashboard bind host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost)
DASHBOARD_HOST=0.0.0.0

# Dashboard port
DASHBOARD_PORT=8080

# Enable HTTPS (requires DASHBOARD_SSL_CERT and DASHBOARD_SSL_KEY)
DASHBOARD_HTTPS=false

# SSL certificate path (only used when DASHBOARD_HTTPS=true)
DASHBOARD_SSL_CERT=

# SSL private key path (only used when DASHBOARD_HTTPS=true)
DASHBOARD_SSL_KEY=

# Basic auth username (leave empty to disable auth)
DASHBOARD_USERNAME=

# Basic auth password (leave empty to disable auth)
DASHBOARD_PASSWORD=

# JPEG camera stream quality (1-100)
DASHBOARD_STREAM_QUALITY=70

# ============================================================
# Mission Management (Module H)
# ============================================================

# SQLite database path
MISSION_DB_PATH=/home/pi/AeroSentinal_VK_2027/data/missions/aerosentinel.db

# Mission reports output directory
MISSION_REPORTS_DIR=/home/pi/AeroSentinal_VK_2027/data/missions/reports

# ============================================================
# Performance / Optimization
# ============================================================

# CPU temperature threshold for inference throttling (degrees Celsius)
THERMAL_THROTTLE_TEMP=80

# CPU temperature for high-temp warning (degrees Celsius)
THERMAL_WARNING_TEMP=75

# Target inference FPS when thermal throttling is active
AI_THROTTLED_FPS=5
